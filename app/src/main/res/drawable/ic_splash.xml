<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 72dp badge inside the 108dp drawable keeps the brand in the system safe zone. -->
    <item android:left="18dp" android:top="18dp" android:right="18dp" android:bottom="18dp">
        <shape android:shape="oval">
            <size android:width="72dp" android:height="72dp" />
            <solid android:color="@color/launcher_background" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_launcher_foreground" />
</layer-list>
